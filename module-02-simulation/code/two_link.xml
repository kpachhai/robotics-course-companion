<mujoco model="two-link">
  <!-- Global physics settings. Everything here applies to the whole scene. -->
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <!-- Defaults are the stylesheet: attributes every element inherits unless it says otherwise. -->
  <default>
    <joint type="hinge" axis="0 1 0" damping="0.4"/>
    <geom type="capsule" size="0.02" rgba="0.18 0.36 0.49 1"/>
    <position kp="12" kv="1.2"/>
    <default class="cube">
      <geom type="box" size="0.03 0.03 0.03" rgba="0.61 0.23 0.18 1"/>
    </default>
  </default>

  <!-- The tree. Nesting is parenthood; pos/quat are relative to the parent body. -->
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.92 0.90 0.85 1"/>

    <body name="upper_arm" pos="0 0 0.6">
      <joint name="shoulder"/>
      <geom name="upper_arm" fromto="0 0 0  0.30 0 0"/>

      <!-- TODO(you) 1: add the forearm.
           A <body name="forearm"> nested right here, offset pos="0.30 0 0" from its
           parent so it starts where the upper arm ends. Give it:
             - <joint name="elbow"/>            (type and axis come from <default>)
             - <geom name="forearm" fromto="0 0 0  0.22 0 0"/>
             - <site name="tip" pos="0.22 0 0" size="0.012" rgba="0.08 0.38 0.31 1"/>
           Nesting is the whole point: put it OUTSIDE </body> and the forearm becomes a
           sibling floating in space instead of a child that swings with the shoulder. -->

    </body>

    <body name="cube" pos="0.42 0 0.03">
      <freejoint name="cube_free"/>
      <geom name="cube" class="cube"/>
    </body>
  </worldbody>

  <!-- Actuators are a flat list, not part of the tree. They name the joint they drive. -->
  <actuator>
    <!-- TODO(you) 2: one <position> actuator per joint.
           <position name="shoulder" joint="shoulder" ctrlrange="-3.14 3.14"/>
           and the same shape for the elbow, with ctrlrange="-2.60 2.60".
           kp and kv are already set for you in <default>. -->
  </actuator>

  <!-- Sensors are also a flat list. -->
  <sensor>
    <!-- TODO(you) 3: two sensors.
           A <framepos> reporting the world position of the site you added:
             objtype="site" objname="tip", named "tip_pos".
           A <jointpos joint="shoulder"/> named "shoulder_q".
           Both need a name= so you can read them by name from Python. -->
  </sensor>

  <!-- qpos order follows the tree: shoulder, elbow, then the cube's 7-number free joint. -->
  <keyframe>
    <!-- TODO(you) 4: a <key name="home" qpos="..."/> with NINE numbers:
           shoulder, elbow, then cube x y z and cube quaternion w x y z.
           Try qpos="-0.9 1.6  0.42 0 0.03  1 0 0 0".
           Get the count wrong and the compiler tells you so; that is the point. -->
  </keyframe>
</mujoco>
